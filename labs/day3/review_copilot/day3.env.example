# Day 3 primary: local Codex CLI + ChatGPT login. Cloud inference, no API key required.
# codex login; CLI execution is explicitly requested with --provider codex_cli --live.
DAY3_LIVE_PROVIDER=codex_cli
# Empty = CLI default; set only an available model ID shown in your account.
CODEX_MODEL=
# Legacy optional adapters are not needed for Day 3.
OLLAMA_LIVE_OPT_IN=0
OLLAMA_MODEL=qwen3:4b
OPENAI_LIVE_OPT_IN=0
OPENAI_MODEL=
OPENAI_API_KEY=
