# Copy this file to .env and replace placeholders only on your local computer.
# Never commit .env or paste a real key into a notebook, slide, issue, or chat.
OPENAI_API_KEY=replace-with-a-new-rotated-key
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low

# Live API calls are opt-in so Run All never creates an unexpected paid request.
RUN_OPENAI_LIVE=0

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
