# Copy this file to .env and replace placeholders only on your local computer.
# Never commit .env or paste a real key into a notebook, slide, issue, or chat.
OPENAI_API_KEY=replace-with-a-new-rotated-key
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low

# Day 2 live lanes are default-off. Change one flag to 1 only for that exercise.
OPENAI_LIVE_OPT_IN=0
OLLAMA_LIVE_OPT_IN=0
FASTER_WHISPER_LIVE_OPT_IN=0
FASTER_WHISPER_MODEL=small

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# LangSmith web upload. Keep automatic tracing off so the raw transcript is not uploaded.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=replace-with-your-langsmith-key
LANGSMITH_PROJECT=ipa-day1-synthetic
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=replace-only-when-your-key-has-multiple-workspaces
